<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="?attr/selectableItemBackground">

    <!-- Row: texts + delete icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Original text snippet row: label + stale badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <!-- Original text snippet (unrendered source text) -->
                <TextView
                    android:id="@+id/tv_annotation_original"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#BB86FC"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Stale badge: annotation no longer locatable (edited source) -->
                <TextView
                    android:id="@+id/tv_annotation_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未找到原文"
                    android:textSize="10sp"
                    android:textColor="#CF6679"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_annotation_stale"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Annotation text -->
            <TextView
                android:id="@+id/tv_annotation_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Per-row edit icon -->
        <ImageView
            android:id="@+id/btn_annotation_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="编辑批注"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="4dp" />

        <!-- Per-row delete icon -->
        <ImageView
            android:id="@+id/btn_annotation_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="删除批注"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#2A2A2A" />

</LinearLayout>
