<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ── -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_background">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_surface">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextColor="@color/md_theme_on_surface"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="@color/md_theme_on_surface" />

            <!-- 查找/替换栏（路线图 #8 文档内文本查找 + #11 编辑模式替换，默认隐藏） -->
            <LinearLayout
                android:id="@+id/find_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/md_theme_surface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/et_find_query"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="查找…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#888888"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_find_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#BB86FC"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btn_find_prev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="上一处"
                        android:src="@drawable/ic_annotation_prev" />

                    <ImageButton
                        android:id="@+id/btn_find_next"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="下一处"
                        android:src="@drawable/ic_annotation_next" />

                    <ImageButton
                        android:id="@+id/btn_find_close"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="关闭查找"
                        android:src="@drawable/ic_close" />

                </LinearLayout>

                <!-- 替换行（仅编辑模式可见；路线图 #11） -->
                <LinearLayout
                    android:id="@+id/replace_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_replace_query"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="替换为…"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#888888"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btn_replace"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="替换"
                        android:textColor="#BB86FC"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_replace_all"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="全部替换"
                        android:textColor="#BB86FC"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 编辑模式格式栏（路线图 #17 编辑格式工具栏，仅编辑模式显示） -->
            <HorizontalScrollView
                android:id="@+id/format_bar_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_theme_surface"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/format_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageButton
                        android:id="@+id/btn_undo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="撤销"
                        android:src="@drawable/ic_undo" />

                    <ImageButton
                        android:id="@+id/btn_redo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="重做"
                        android:src="@drawable/ic_redo" />

                    <ImageButton
                        android:id="@+id/btn_format_bold"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="加粗（**文本**）"
                        android:src="@drawable/ic_format_bold" />

                    <ImageButton
                        android:id="@+id/btn_format_italic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="斜体（_文本_）"
                        android:src="@drawable/ic_format_italic" />

                    <TextView
                        android:id="@+id/btn_format_h1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="一级标题"
                        android:gravity="center"
                        android:text="H1"
                        android:textColor="#BB86FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_format_h2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="二级标题"
                        android:gravity="center"
                        android:text="H2"
                        android:textColor="#BB86FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_format_h3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="三级标题"
                        android:gravity="center"
                        android:text="H3"
                        android:textColor="#BB86FC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_format_list"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="无序列表（- 逐行切换）"
                        android:src="@drawable/ic_format_list" />

                    <ImageButton
                        android:id="@+id/btn_format_ordered"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="有序列表（1. 逐行切换）"
                        android:src="@drawable/ic_format_list_numbered" />

                    <ImageButton
                        android:id="@+id/btn_format_task"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="任务清单（- [ ] / - [x] 逐行切换）"
                        android:src="@drawable/ic_task_check" />

                    <ImageButton
                        android:id="@+id/btn_format_quote"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="引用（> 逐行切换）"
                        android:src="@drawable/ic_format_quote" />

                    <ImageButton
                        android:id="@+id/btn_format_strike"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="删除线（~~文本~~）"
                        android:src="@drawable/ic_format_strikethrough" />

                    <ImageButton
                        android:id="@+id/btn_format_code"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="行内代码（`文本`）"
                        android:src="@drawable/ic_code_inline" />

                </LinearLayout>

            </HorizontalScrollView>

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </ScrollView>

        <EditText
            android:id="@+id/et_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_background"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/md_theme_primary"
            android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ── Right-side annotation drawer ── -->
    <LinearLayout
        android:id="@+id/drawer_annotations"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#1E1E1E">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:background="#2D2D2D">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="批注列表"
                android:textColor="#E0E0E0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_annotation_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BB86FC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_annotation_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="导出"
                android:textColor="#BB86FC"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333" />

        <!-- Tab switcher: 批注 / 大纲（路线图 #6 TOC 导航入口，抽屉双 Tab） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#252525">

            <TextView
                android:id="@+id/tv_tab_annotations"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="批注"
                android:textColor="#BB86FC"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_tab_toc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="大纲"
                android:textColor="#888888"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333" />

        <!-- Annotation list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_annotation_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:overScrollMode="always"
            android:visibility="gone" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layout_empty_annotations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无批注"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="长按选中文字以添加批注"
                android:textColor="#555555"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- TOC (大纲) list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_toc_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:overScrollMode="always"
            android:visibility="gone" />

        <!-- TOC empty state -->
        <LinearLayout
            android:id="@+id/layout_empty_toc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本文档没有标题"
                android:textColor="#666666"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
